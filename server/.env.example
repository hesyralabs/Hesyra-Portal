# Copy to .env and fill in. .env is gitignored.

# Prisma datasource. The schema's provider is `sqlite`, so this must be a
# SQLite URL for local development — the path is relative to server/.
DATABASE_URL="file:./dev.db"

# Signing secret for auth tokens. Use a long random string in production.
JWT_SECRET="change-me"

PORT=3001

# ─── Payments ─────────────────────────────────────────────────────
# `test` runs the stubbed payment engine with no Razorpay account and
# enables the /simulate endpoints. `live` calls Razorpay for real.
#
# In live mode all three values below are required and the server
# refuses to start without them. Key id and secret come from Razorpay
# Dashboard → Account & Settings → API Keys. The webhook secret is a
# DIFFERENT value, set by you when you create the webhook under
# Settings → Webhooks — it is not one of the API keys, and using the
# key secret here makes every incoming webhook fail verification.
#
# The webhook endpoint to register is:
#   https://<your-domain>/api/payment/webhook
# subscribed to: payment.captured, payment_link.paid, order.paid
RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Public origin of the portal, used for Razorpay payment-link callbacks.
# Without it a paid link lands on Razorpay's own receipt page instead of
# returning the dentist to the portal — harmless, just less tidy.
# APP_BASE_URL=https://portal.hesyralabs.com

# ─── Tax registration ─────────────────────────────────────────────
# Printed on every invoice, and its first two digits are the state code
# that decides CGST+SGST (intra-state) vs IGST (inter-state). The server
# refuses to start in live mode while this is unset or a placeholder.
# HESYRA_GSTIN=27ABCDE1234F1Z5
# HESYRA_LEGAL_NAME="Hesyra Labs"
# HESYRA_ADDRESS="Nagpur, Maharashtra, India"

# ─── Email ────────────────────────────────────────────────────────
# Optional. Only the admin case-statement export sends mail; nothing
# else in the portal has an email path. Leave these unset and the
# "Email to me" button stays disabled with an explanation rather than
# silently failing — Download and Preview work regardless.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Hesyra Labs <cases@hesyralabs.com>"
